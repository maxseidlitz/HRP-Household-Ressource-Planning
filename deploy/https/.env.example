# Kopieren nach .env und anpassen.

# Die (Sub-)Domain, unter der die WG-App laufen soll. Ihr DNS-Eintrag (A/AAAA)
# muss auf die öffentliche IP eures Anschlusses zeigen.
DOMAIN=wg.example.de

# Kontakt für die Push-Dienste von Apple/Google/Mozilla (mailto: oder https://)
VAPID_SUBJECT=mailto:admin@example.de

# Ports auf dem ZimaBoard. ZimaOS belegt 80 selbst: dann z. B. 8080/8443
# nehmen und im Router 80 → 8080 und 443 → 8443 weiterleiten.
HTTP_PORT=80
HTTPS_PORT=443

# Datenordner der App (wie bisher) und Caddys Zertifikate (getrennt)
DATA_PATH=/DATA/AppData/hrp
CADDY_PATH=/DATA/AppData/hrp-caddy
